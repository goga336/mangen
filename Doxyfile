# Doxyfile
PROJECT_NAME           = "mangen"
PROJECT_BRIEF          = "Directory SHA-256 manifest generator"
OUTPUT_DIRECTORY       = doc
INPUT                  = README.md src inc
USE_MDFILE_AS_MAINPAGE = README.md
FILE_PATTERNS          = *.c *.h *.md
RECURSIVE              = YES
EXCLUDE_PATTERNS       = */rfc6234/*
GENERATE_HTML          = YES
GENERATE_LATEX         = NO
OPTIMIZE_OUTPUT_FOR_C  = YES
EXTRACT_ALL            = YES
EXTRACT_STATIC         = YES
HAVE_DOT               = NO